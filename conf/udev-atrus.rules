SUBSYSTEM=="usb", ENV{ID_VENDOR_ID}=="18d1", ENV{ID_MODEL_ID}=="8001", GOTO="atrus_action"

GOTO="atrus_end"

LABEL="atrus_action"

ACTION=="add", RUN+="/bin/mkdir -p /run/atrusctl"
ACTION=="add", RUN+="/bin/chown atrus:atrus /run/atrusctl"
ACTION=="add", RUN+="/sbin/minijail0 -u atrus -g atrus -e -l -v -c 4096 -- /usr/sbin/atrusctl daemon /lib/firmware/limes_audio/atrus-fw-bundle.bin"

ACTION=="remove", RUN+="/sbin/minijail0 -u atrus -g atrus -e -l -v -- /usr/sbin/atrusctl daemon --stop"

LABEL="atrus_end"
